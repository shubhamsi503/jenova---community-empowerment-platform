# GEMINI_API_KEY: Required for server-side Gemini AI Community Assistant calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign authentication session tokens on the server.
SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

